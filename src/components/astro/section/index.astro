---
import FrameworkBubble from "../framework-bubble/index.astro";
import { FRAMEWORKS } from "../framework-bubble/index.astro";

interface Props {
  backgroundColor: string;
  framework?: keyof typeof FRAMEWORKS;
  style?: Record<string, string>;
}

const { backgroundColor, framework, style } = Astro.props;
---

<div data-section style={{ backgroundColor, ...style }}>
  <div class="body">
    <div class="layer">
      <slot />
    </div>
    <div class="layer bubble">
      {framework && <FrameworkBubble framework={framework} />}
    </div>
  </div>
</div>

<style>
  [data-section] {
    scroll-snap-align: start;

    display: flex;
    flex-direction: column;
    overflow: hidden;

    height: 100dvh;
    width: 100vw;
    max-height: -webkit-fill-available;
  }

  .body {
    position: relative;
    flex-grow: 1;
  }

  .layer {
    position: absolute;
    inset: 0;
  }

  .bubble {
    user-select: none;
    pointer-events: none;
  }
</style>
