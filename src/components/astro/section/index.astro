---
import FrameworkBubble from "../framework-bubble/index.astro";
import { FRAMEWORKS } from "../framework-bubble/index.astro";

interface Props {
  backgroundColor: string;
  framework?: keyof typeof FRAMEWORKS;
}

const { backgroundColor, framework } = Astro.props;
---

<div
  class="snap-start h-dvh w-screen max-h-[-webkit-fill-available] flex flex-col overflow-hidden"
  style={{ backgroundColor }}
>
  <!-- grow, because the boxes below are absolute and would leave this one zero
       tall. Their max-h-[-webkit-fill-available] resolves against it, so a zero
       height here collapses them and everything inside lands off the top. -->
  <div class="relative grow">
    <div class="absolute h-dvh w-screen max-h-[-webkit-fill-available]">
      <slot />
    </div>
    <div
      class="select-none pointer-events-none absolute h-dvh w-screen max-h-[-webkit-fill-available]"
    >
      {framework && <FrameworkBubble framework={framework} />}
    </div>
  </div>
</div>
