---
import { Image } from "astro:assets";

import Bubble from "./assets/bubble.png";
import Preact from "./assets/preact.svg";
import React from "./assets/react.svg";
import Svelte from "./assets/svelte.svg";
import Vue from "./assets/vue.svg";

interface Framework {
  display: string;
  src: ImageMetadata;
}

export const FRAMEWORKS: Record<string, Framework> = {
  preact: {
    display: "Preact",
    src: Preact,
  },
  react: {
    display: "React",
    src: React,
  },
  svelte: {
    display: "Svelte",
    src: Svelte,
  },
  vue: {
    display: "Vue",
    src: Vue,
  },
};

interface Props {
  framework: keyof typeof FRAMEWORKS;
}

const { framework } = Astro.props;
const { display, src } = FRAMEWORKS[framework];
---

<div class="framework-bubble">
  <div class="stack">
    <Image
      loading="eager"
      class="bubble"
      src={Bubble}
      alt={`Built with ${display}`}
    />
    <Image loading="eager" class="logo" src={src} alt={display} />
  </div>
</div>

<style>
  .framework-bubble {
    display: flex;
    align-items: flex-end;
    position: relative;

    width: 100vw;
    height: 100dvh;
  }

  .stack {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;

    max-width: 10rem;
  }

  .bubble {
    width: 15vw;
  }

  @media (min-width: 48rem) {
    .bubble {
      width: 20vw;
    }
  }

  .logo {
    position: absolute;
    width: 25%;
    margin-top: 40%;
  }
</style>
